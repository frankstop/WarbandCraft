{
  "schemaVersion": 1,
  "id": "warbandcraft",
  "version": "${version}",
  "name": "WarbandCraft (experimental)",
  "description": "Experimental Minecraft Java bridge for Mount & Blade: Warband. Requires the WSE2 host adapter.",
  "authors": [
    "WarbandCraft contributors",
    "justbustin (upstream bridge)"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.wbmc.bridge.WarbandBridgeMod"
    ],
    "client": [
      "dev.wbmc.bridge.client.WarbandBridgeClient"
    ]
  },
  "mixins": [
    "warbandcraft.mixins.json",
    {
      "config": "warbandcraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
